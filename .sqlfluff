# Postgres dialect for infra/postgres init SQL. The dbt project (Phase 8)
# gets its own .sqlfluff with the trino dialect and dbt templater.
[sqlfluff]
dialect = postgres
max_line_length = 100
# RF04: column names such as name/status are fixed by the domain model.
exclude_rules = LT05, RF04

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper
