# Copy to .env (git-ignored) and adjust. Every image tag is pinned here.
# Later phases append their own sections.

# --- Compose ---------------------------------------------------------------
COMPOSE_PROJECT_NAME=fmcg
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# --- Base images (custom Python images) -----------------------------------
# bookworm (not trixie): Debian trixie no longer ships OpenJDK 17, which Spark 3.5 needs.
PYTHON_IMAGE=python:3.11.17-slim-bookworm
UV_IMAGE=ghcr.io/astral-sh/uv:0.10.9

# --- Source: PostgreSQL (Phase 1a) ----------------------------------------
POSTGRES_IMAGE=postgres:16.15
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fmcg
POSTGRES_USER=fmcg
POSTGRES_PASSWORD=change-me
# Debezium replication user (least privilege)
DEBEZIUM_DB_USER=debezium
DEBEZIUM_DB_PASSWORD=change-me
POSTGRES_MEM_LIMIT=1g

# --- Simulator (Phase 1b) --------------------------------------------------
SIM_RATE=5
SIM_SEED=42
SIMULATOR_MEM_LIMIT=256m

# --- Kafka (Phase 2) ---------------------------------------------------------
KAFKA_IMAGE=apache/kafka:3.9.2
KAFKA_UI_IMAGE=kafbat/kafka-ui:v1.5.0
# KRaft cluster id (base64 UUID). Fixed so the data volume always matches; not a secret.
KAFKA_CLUSTER_ID=N_EQadNKR3WC_js68GAQnA
KAFKA_RETENTION_HOURS=168
KAFKA_HEAP_OPTS="-Xms512m -Xmx512m"
KAFKA_MEM_LIMIT=1g
KAFKA_UI_JAVA_OPTS=-Xmx256m
KAFKA_UI_MEM_LIMIT=512m

# --- CDC: Kafka Connect + Debezium (Phase 3) ----------------------------------
DEBEZIUM_CONNECT_IMAGE=quay.io/debezium/connect:2.7.4.Final
CURL_IMAGE=curlimages/curl:8.22.0
KAFKA_CONNECT_HEAP_OPTS="-Xms256m -Xmx768m"
KAFKA_CONNECT_MEM_LIMIT=1g

# --- Lake: MinIO, Hive Metastore, Spark (Phase 4) -----------------------------
# MinIO stopped publishing images; Bitnami's last (legacy, frozen) build is used.
MINIO_IMAGE=bitnamilegacy/minio:2025.7.23-debian-12-r5
MINIO_CLIENT_IMAGE=bitnamilegacy/minio-client:2025.7.21-debian-12-r3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
# Least-privilege service user (lakehouse + checkpoints buckets only) for Spark/HMS/Trino.
LAKE_ACCESS_KEY=lakehouse
LAKE_SECRET_KEY=change-me-lake
HIVE_IMAGE=apache/hive:3.1.3
HMS_DB_NAME=metastore
HMS_DB_USER=hive
HMS_DB_PASSWORD=change-me
SPARK_DRIVER_MEMORY=1g
MINIO_MEM_LIMIT=768m
HMS_DB_MEM_LIMIT=256m
HMS_MEM_LIMIT=768m
SPARK_MEM_LIMIT=2g
